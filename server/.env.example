# ─────────────────────────────────────────────────────────────────────────
# CNC Analysis API — environment template
#
# Copy to `.env` (or `.env.local`) and edit. The server boots with all of
# these unset and falls back to in-repo defaults; the values below show
# what each knob controls and where it gets read.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
SERVER_TITLE="CNC Analysis API"
SERVER_VERSION=1.0.0
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── LLM (Qwen3-VL via vLLM / Ollama-compatible) ──────────────────────────
# VISION_MODEL_URL  : base URL of the OpenAI-compatible chat endpoint.
# VISION_MODEL_NAME : model id sent in the chat-completions request.
# Engine 1 (vision drawing extraction) always uses this backend. Engine 3
# also routes here when ``model`` is missing or carries the ``vllm:`` prefix.
VISION_MODEL_URL=http://localhost:11434
VISION_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct-FP8
VLM_INACTIVITY_SECONDS=30
VLM_THINKING_BUDGET_TOKENS=6000
VLM_MAX_TOKENS=12288
TEXT_LLM_MAX_TOKENS=6144
TEXT_LLM_THINKING_BUDGET=1024

# ── OpenRouter (Engine 3 default — Claude / GPT / Gemini / DeepSeek) ─────
# OPENROUTER_API_KEY                  : required to route Engine 3 through
#                                       OpenRouter. Server still boots without
#                                       it; requests that pick an OpenRouter
#                                       slug return an error frame.
# OPENROUTER_BASE_URL                 : OpenAI-compatible endpoint base.
# OPENROUTER_DEFAULT_MODEL            : slug used when AnalyzeRequest.model
#                                       is omitted. Set to ``vllm:<name>`` to
#                                       keep the legacy vLLM default.
# OPENROUTER_HTTP_REFERER / _APP_TITLE: attribution headers shown on the
#                                       OpenRouter dashboard.
# OPENROUTER_INACTIVITY_SECONDS       : SSE stream watchdog cutoff.
# OPENROUTER_REQUEST_TIMEOUT          : per-request hard cap (seconds).
# OPENROUTER_DEFAULT_REASONING_EFFORT : low | medium | high — drives the
#                                       unified ``reasoning: {effort}`` param.
# OPENROUTER_MAX_TOKENS               : default completion cap.
# OPENROUTER_ALLOWED_MODELS           : comma-separated allowlist exposed
#                                       by GET /v1/models for the UI
#                                       dropdown. Other slugs are still
#                                       callable from the API.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_HTTP_REFERER=https://cncmachining.local
OPENROUTER_APP_TITLE=CNC Quote Engine
OPENROUTER_INACTIVITY_SECONDS=90
OPENROUTER_REQUEST_TIMEOUT=300
OPENROUTER_DEFAULT_REASONING_EFFORT=medium
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_ALLOWED_MODELS=anthropic/claude-sonnet-4.5,anthropic/claude-opus-4.5,openai/gpt-5,openai/gpt-5-mini,google/gemini-2.5-pro,google/gemini-2.5-flash,deepseek/deepseek-v3.2,qwen/qwen3-max

# ── 2D extraction (Engine 1) ─────────────────────────────────────────────
# PDF_LONG_SIDE_PX        : resize long edge to this many pixels before VLM.
# PDF_TARGET_DPI          : raster DPI when pdftoppm is used as fallback.
# PDF_MAX_PAGES_FOR_VISION: 0 = every page; cap for cost control.
# VLM_PAGE_RETRIES        : retries per page on parse failure.
# VLM_PHASE_DEADLINE_SEC  : kill Engine 1 after this many seconds.
PDF_LONG_SIDE_PX=2000
PDF_TARGET_DPI=150
PDF_MAX_PAGES_FOR_VISION=0
VLM_PAGE_RETRIES=1
VLM_PHASE_DEADLINE_SEC=600

# ── 3D extraction (Engine 2) ─────────────────────────────────────────────
# OCC_PYTHON              : interpreter with cadquery-ocp installed; the OCC
#                           recognizer subprocess uses it. Defaults to the
#                           Python running uvicorn.
# STEPANALYZER_TIMEOUT_SEC: kill the OCC recognizer after this many seconds.
# WELDING_TIMEOUT_SEC     : kill the FreeCAD welding subprocess.
# FREECAD_PYTHON          : Python interpreter inside the FreeCAD env
#                           (used for both welding detection and G-code).
OCC_PYTHON=
STEPANALYZER_TIMEOUT_SEC=240
WELDING_TIMEOUT_SEC=120
FREECAD_PYTHON=

# ── Process mapping (Engine 3) ───────────────────────────────────────────
# DEFAULT_POST_PROCESSOR   : FreeCAD Path post-processor name (linuxcnc, mach3…).
# GCODE_TIMEOUT_SEC        : timeout for the FreeCAD Path subprocess.
# BLENDED_RATE_USD_PER_HR  : single blended labor+machine rate. 0 disables
#                            and uses per-role / per-machine split.
# DEFAULT_BATCH_SIZE       : assumed lot size when client omits it.
DEFAULT_POST_PROCESSOR=linuxcnc
GCODE_TIMEOUT_SEC=60
BLENDED_RATE_USD_PER_HR=75
DEFAULT_BATCH_SIZE=1

# ── Agentic engine routing ──────────────────────────────────────────────
# AGENTIC_ENGINE_MODE : stub | true | shadow   (only stub is implemented)
# AGENTIC_WRITE_KB    : whether the LLM planner writes back to the KB.
AGENTIC_ENGINE_MODE=stub
AGENTIC_WRITE_KB=false

# ── Engine 3 selection (mutually exclusive backends) ────────────────────
# ENGINE_MODE : agentic | rag
#   agentic — multi-turn ReAct loop with kb/catalog tools (default).
#   rag     — one-shot LLM call grounded by pgvector retrieval over the
#             ingested KB index. See server/engines/rag/ingestion/.
# Per-request override: clients may pass ?engine=agentic|rag in the
# query string or `engine` in the JSON body to /v1/analyze-stream.
ENGINE_MODE=agentic

# ── RAG engine (pgvector + OpenAI embeddings) ───────────────────────────
# OPENAI_API_KEY          : required when ENGINE_MODE=rag (or for the
#                           ingestion CLI). Server boots without it; RAG
#                           retrieval returns [] until set.
# OPENAI_BASE_URL         : override for OpenAI-compatible providers.
# OPENAI_EMBEDDING_MODEL  : embedding model id. text-embedding-3-small is
#                           1536-dim — must match VECTOR(1536) in
#                           ingestion/schema.sql. Changing models means
#                           dropping and rebuilding the index.
# RAG_TOP_K               : nearest analogues retrieved per component.
# RAG_TOP_K_PATTERNS      : pattern chunks (used only when analogue
#                           coverage is weak).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_TOP_K_PATTERNS=3

# ── Supabase (per-user shop catalog + pgvector RAG index) ───────────────
# Service-role key bypasses RLS — never expose it client-side.
# For RAG: apply server/engines/rag/ingestion/schema.sql once per
# project, then run `python -m server.engines.rag.ingestion.build_index`.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline tracing is emitted inline via the standard logger
# (cncserver.pipeline.trace) — no file output. Set LOG_LEVEL=INFO (the
# default) to see each engine's output during a run.
