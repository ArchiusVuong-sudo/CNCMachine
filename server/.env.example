# ─────────────────────────────────────────────────────────────────────────
# CNC Analysis API — environment template
#
# Copy to `.env` (or `.env.local`) and edit. The server boots with all of
# these unset and falls back to in-repo defaults; the values below show
# what each knob controls and where it gets read.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
SERVER_TITLE="CNC Analysis API"
SERVER_VERSION=1.0.0
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── LLM (Qwen3-VL via vLLM / Ollama-compatible) ──────────────────────────
# VISION_MODEL_URL  : base URL of the OpenAI-compatible chat endpoint.
# VISION_MODEL_NAME : model id sent in the chat-completions request.
# Engine 1 (vision drawing extraction) always uses this backend. Engine 3
# falls back here when ``model`` is missing/``vllm:``-prefixed and the Kimi
# agent backend (below) is not configured.
VISION_MODEL_URL=http://localhost:11434
VISION_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct-FP8
# VISION_MODEL_API_KEY : bearer token for the vision endpoint. Leave blank
# for local vLLM (no auth). Set when ``VISION_MODEL_URL`` points at a hosted
# OpenAI-compatible provider — Gemini's ``v1beta/openai`` shim, OpenAI,
# OpenRouter, etc. Detected hosts also strip vLLM-only fields
# (``chat_template_kwargs``, ``skip_special_tokens``, ``repetition_penalty``)
# from the payload so the request validates.
#
# Drop-in Gemini setup (lets you run the pipeline without a GPU pod):
#   VISION_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   VISION_MODEL_NAME=gemini-2.5-flash    # or gemini-2.5-pro for better vision
#   VISION_MODEL_API_KEY=<your AI Studio key>
# And mirror them on the agent path so Engine 3 uses the same backend:
#   AGENT_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AGENT_LLM_MODEL=gemini-2.5-flash
#   AGENT_LLM_API_KEY=<same key>
#
# CoFab-hosted Qwen3-VL on vast.ai (team's prod GPU, shared dev access):
#   VISION_MODEL_URL=https://four-regards-favors-josh.trycloudflare.com
#   VISION_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct-FP8
#   VISION_MODEL_API_KEY=<ask boss for token>
# And mirror for the agent (same backend, text-only path):
#   AGENT_LLM_URL=https://four-regards-favors-josh.trycloudflare.com
#   AGENT_LLM_MODEL=Qwen/Qwen3-VL-32B-Instruct-FP8
#   AGENT_LLM_API_KEY=<same token>
# The trycloudflare URL rotates when the pod restarts — ping the team
# Slack for the current value, or check `tail /workspace/logs/cloudflared-vllm.log`
# on the pod for `https://*.trycloudflare.com`.
VISION_MODEL_API_KEY=
VLM_INACTIVITY_SECONDS=30
VLM_THINKING_BUDGET_TOKENS=6000
VLM_MAX_TOKENS=12288
TEXT_LLM_MAX_TOKENS=6144
TEXT_LLM_THINKING_BUDGET=1024

# ── Agent backend (Kimi-Linear — Engine 3 planner, second vLLM pod) ──────
# A dedicated OpenAI-compatible vLLM endpoint for the agentic planner.
# When AGENT_LLM_URL is set, Engine 3 defaults to it automatically (the
# default model becomes ``agent:<AGENT_LLM_MODEL>``) and the ``agent:``
# slug prefix routes any request here. Engine 1 (vision) stays on the
# Qwen3-VL backend above — Kimi-Linear is text-only.
#
# IMPORTANT: this backend is sent PLAIN JSON-by-instruction. The provider
# never forwards ``response_format`` (Kimi's slow tiktoken tokenizer has no
# vLLM grammar backend — guided JSON crashes the engine) nor Qwen
# ``chat_template_kwargs``. The system prompt's "one JSON object per turn"
# contract + parse_model_json salvage carry it instead.
#
# AGENT_LLM_URL                : base URL of the Kimi vLLM pod. Unset = the
#                                whole agent path is dormant (Engine 3 falls
#                                back to the local Qwen vLLM backend).
# AGENT_LLM_MODEL              : served-model-name on that pod (vLLM
#                                --served-model-name).
# AGENT_LLM_API_KEY            : optional bearer token (vLLM usually needs none).
# AGENT_DEFAULT_MODEL          : explicit Engine-3 default slug. Leave blank
#                                to auto-derive ``agent:<AGENT_LLM_MODEL>``
#                                whenever AGENT_LLM_URL is set.
# AGENT_LLM_INACTIVITY_SECONDS : SSE stream watchdog cutoff.
# AGENT_LLM_MAX_TOKENS         : default completion cap per turn.
# AGENT_LLM_FAILOVER           : optional slug to retry on if the Kimi pod
#                                errors (e.g. vllm:Qwen/Qwen3-VL-32B-Instruct-FP8).
#                                Off if blank. The ONLY way Qwen re-enters the
#                                agentic engine — off by default.
# AGENT_LLM_TEMPERATURE        : Kimi sampling temperature. Default 0.6
#                                (Moonshot's recommendation). Do NOT use 0.0 —
#                                greedy decoding degenerates Kimi-Linear into
#                                repeated-token collapse ('{"!!!!…').
# AGENT_LLM_TOP_P              : Kimi nucleus sampling. Default 0.95.
AGENT_LLM_URL=
AGENT_LLM_MODEL=kimi-agent
AGENT_LLM_API_KEY=
AGENT_DEFAULT_MODEL=
AGENT_LLM_INACTIVITY_SECONDS=120
AGENT_LLM_MAX_TOKENS=8192
AGENT_LLM_FAILOVER=
AGENT_LLM_TEMPERATURE=0.6
AGENT_LLM_TOP_P=0.95

# ── 2D extraction (Engine 1) ─────────────────────────────────────────────
# PDF_LONG_SIDE_PX        : resize long edge to this many pixels before VLM.
# PDF_TARGET_DPI          : raster DPI when pdftoppm is used as fallback.
# PDF_MAX_PAGES_FOR_VISION: 0 = every page; cap for cost control.
# VLM_PAGE_RETRIES        : retries per page on parse failure.
# VLM_PHASE_DEADLINE_SEC  : kill Engine 1 after this many seconds.
PDF_LONG_SIDE_PX=2000
PDF_TARGET_DPI=150
PDF_MAX_PAGES_FOR_VISION=0
VLM_PAGE_RETRIES=1
VLM_PHASE_DEADLINE_SEC=600

# ── 3D extraction (Engine 2) ─────────────────────────────────────────────
# OCC_PYTHON              : interpreter with cadquery-ocp installed; the OCC
#                           recognizer subprocess uses it. Defaults to the
#                           Python running uvicorn.
# STEPANALYZER_TIMEOUT_SEC: kill the OCC recognizer after this many seconds.
# WELDING_TIMEOUT_SEC     : kill the FreeCAD welding subprocess.
# FREECAD_PYTHON          : Python interpreter inside the FreeCAD env
#                           (used for both welding detection and G-code).
OCC_PYTHON=
STEPANALYZER_TIMEOUT_SEC=240
WELDING_TIMEOUT_SEC=120
FREECAD_PYTHON=

# ── Process mapping (Engine 3) ───────────────────────────────────────────
# DEFAULT_POST_PROCESSOR   : FreeCAD Path post-processor name (linuxcnc, mach3…).
# GCODE_TIMEOUT_SEC        : timeout for the FreeCAD Path subprocess.
# BLENDED_RATE_USD_PER_HR  : single blended labor+machine rate. 0 disables
#                            and uses per-role / per-machine split.
# DEFAULT_BATCH_SIZE       : assumed lot size when client omits it.
DEFAULT_POST_PROCESSOR=linuxcnc
GCODE_TIMEOUT_SEC=60
BLENDED_RATE_USD_PER_HR=75
DEFAULT_BATCH_SIZE=1

# ── Agentic engine routing ──────────────────────────────────────────────
# AGENTIC_ENGINE_MODE : stub | true | shadow   (only stub is implemented)
# AGENTIC_WRITE_KB    : whether the LLM planner writes back to the KB.
AGENTIC_ENGINE_MODE=stub
AGENTIC_WRITE_KB=false

# ── Engine 3 selection ──────────────────────────────────────────────────
# ENGINE_MODE : agentic
#   agentic — multi-turn ReAct loop with kb/catalog tools (the only
#             supported planner).
# Per-request override: clients may pass ?engine=agentic in the query
# string or `engine` in the JSON body to /v1/analyze-stream.
ENGINE_MODE=agentic

# ── Supabase (per-user shop catalog) ────────────────────────────────────
# Service-role key bypasses RLS — never expose it client-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline tracing is emitted inline via the standard logger
# (cncserver.pipeline.trace) — no file output. Set LOG_LEVEL=INFO (the
# default) to see each engine's output during a run.
