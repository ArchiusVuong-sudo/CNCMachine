# Ignore everything at root by default
/*

# Allow only the 3 target folders + this gitignore
!/.gitignore
!/KNOWLEDGE_BASE/
!/server/
!/frontend/

# === Secrets: never commit (templates with .example suffix are kept) ===
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.development

# === Python ===
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# === Node / Next.js ===
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/.vercel/

# === Logs & runtime output ===
**/*.log
/server/runs/

# === KB material NOT consumed by the agent at runtime ===
# Kept locally on disk, but not shipped in the repo / customer package.
# (agent loads only AGENT.md + MEMORY.md into the prompt, reads parts/
#  patterns/reference/methodology via kb_read, and queries extracted/*.csv —
#  never these.)
/KNOWLEDGE_BASE/_research/
/KNOWLEDGE_BASE/_tools/
/KNOWLEDGE_BASE/extracted/_shards/
/KNOWLEDGE_BASE/README.md
/KNOWLEDGE_BASE/AGENT_TOOLS.md

# === OS / editor ===
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
