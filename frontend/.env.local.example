# ─── Python API server (CNC pipeline) ───────────────────────────────────────
# The Next.js catch-all proxy at /api/v1/[...path] forwards every request to
# this URL. Matches `HOST:PORT` in ../server/.env (default 0.0.0.0:8001).
# LOCAL DEV:    http://localhost:8001
# RUNPOD:       https://<pod-id>-8001.proxy.runpod.net
PYTHON_SERVICE_URL=http://localhost:8001

# ─── Supabase (Storage only — STEP / drawing uploads) ───────────────────────
# Browser uploads bypass the proxy and go straight to Supabase Storage with
# the anon key. Every other read/write goes through PYTHON_SERVICE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
